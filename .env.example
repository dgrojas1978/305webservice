# MongoDB — REQUIRED in production for quote-form lead storage.
# Without it the form shows an error state instead of pretending to submit.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/305-web-service

# WhatsApp number for all "Chat on WhatsApp" CTAs.
# Digits only, including country code (e.g. 13055550100).
# IMPORTANT: the fallback in code (13051234567) looks like a placeholder —
# set the real business number here before launch.
VITE_WHATSAPP_NUMBER=13051234567

# Public contact email shown in the footer and contact page.
VITE_CONTACT_EMAIL=info@305webservice.com
